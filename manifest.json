{
  "manifest_version": 3,
  "name": "Subtitle Insights",
  "version": "0.1.2",
  "key": "",
  "description": "Smart AI insights and translations for YouTube subtitles",
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "content_scripts": [
    {
      "js": ["src/content/index.tsx"],
      "matches": ["https://www.youtube.com/*", "https://web.stremio.com/*"]
    }
  ],
  "action": {
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "host_permissions": ["*://*.youtube.com/*", "https://web.stremio.com/*"],
  "permissions": ["storage", "webRequest"],
  "commands": {
    "previous_segment": {
      "description": "Move to previous segment"
    },
    "next_segment": {
      "description": "Move to next segment"
    },
    "replay_segment": {
      "description": "Replay segment"
    },
    "toggle_extension": {
      "description": "Toggle Extension"
    }
  },
  "options_ui": {
    "page": "src/settings/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["dict/*.dat.gz"],
      "matches": ["<all_urls>"]
    }
  ]
}
